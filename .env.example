# PostgreSQL (db/postgres_client.py, read via config.db_settings)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=equity_research
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
# Only for a hosted database (for example Supabase): require an encrypted connection. Leave unset locally.
# POSTGRES_SSLMODE=require

# LLM for the screening agent and the news summary step (config.llm_settings)
# Any OpenAI-compatible endpoint works.
# NEVER hardcode this key in a script — always read it from here via os.getenv.
# All three are required, there are no defaults.
MANAGED_LLM_API_KEY=
LLM_BASE_URL=https://your-llm-endpoint/v1
LLM_MODEL=your-model-name

# SEC EDGAR requires a real contact in the User-Agent: "<name or company> <email>".
# Requests without one are rejected by sec.gov.
SEC_USER_AGENT="Your Name your.email@example.com"

# full = your PC (everything). demo = the online dashboard: live SEC EDGAR + Yahoo Finance only, article
# text read with curl_cffi only (no browser), no SearXNG, no FinBERT; ratios, search news and sentiment
# scores are read from the shared database (prepared by the full-mode backend).
APP_MODE=full

# Local SearXNG container used for news search (sources/searxng_news.py).
# Needs `formats: [html, json]` under `search:` in its settings.yml.
SEARXNG_URL=http://localhost:8888

# --- Publishing to the hosted database (scripts/online/*) ---------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (keep ?sslmode=require).
# Used only by scripts/online/publish_to_supabase.py and apply_schema.py.
# TARGET_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
